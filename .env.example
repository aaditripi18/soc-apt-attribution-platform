# G0.7 platform-stack configuration — the "normal" profile, targeting the
# accepted ≥16 GB host RAM baseline (C0.2 §A.1.3, §I).
#
# Usage:
#   cp .env.example .env
#   # then edit ELASTIC_PASSWORD / KIBANA_PASSWORD below
#   docker compose up -d
#
# .env is gitignored (see .gitignore) — never commit real passwords.
# For an 8 GB host, use .env.constrained.example instead (see README.md).

# --- Pinned image versions (docker.elastic.co) -----------------------------
# Elasticsearch and Kibana MUST be the same version. Bump deliberately (per
# CLAUDE.md principle 12: document, don't silently change) — never float to
# ":latest".
STACK_VERSION=8.15.3

# --- Cluster / ports ---------------------------------------------------------
CLUSTER_NAME=attribution-platform-dev
ES_PORT=9200
KIBANA_PORT=5601

# --- Credentials (REQUIRED — compose refuses to start without these) -------
# Dev-only placeholder values. Replace with your own before `docker compose
# up`; these are never used to store anything sensitive at this gate (no
# telemetry, no real data ingested yet).
ELASTIC_PASSWORD=changeme-elastic
KIBANA_PASSWORD=changeme-kibana

# --- Resource sizing (normal / ≥16 GB host profile) -------------------------
# Elastic recommends >=8 GB RAM for Elasticsearch alone; ES_HEAP should be
# <=50% of ES_MEM_LIMIT (the JVM heap needs headroom for off-heap memory).
ES_HEAP=4g
ES_MEM_LIMIT=6g
KB_MEM_LIMIT=1g
