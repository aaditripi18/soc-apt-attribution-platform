/.elastic/

# --- data/: local-only by default, EXCEPT the vendored, hash-verified
#     ATT&CK STIX bundle under data/attack/, which is deliberately tracked
#     (G0.1 — docs/architecture/11-attack-knowledge-versioning.md), and the
#     versioned calibration corpus under data/calibration/, which is a
#     deliberately-tracked, provenance-first data artifact
#     (C3.2 — docs/architecture/14-c3.2-corpus-build.md; ADR-0006 §D13).
#     The pinned SigmaHQ release archive and the rule pack/report generated
#     from it under data/detection/ are tracked for the same reason
#     (ADR-0007 D7 — detection content is a versioned, hash-pinned input), and the
#     commit-pinned real telemetry samples under data/telemetry-samples/ used by
#     adapter golden tests (ADR-0008 D2.3), and the hash-pinned government-advisory
#     indicator bundles under data/intel/ (ADR-0013 D2). ---
/data/*
!/data/attack/
!/data/calibration/
!/data/detection/
!/data/telemetry-samples/
!/data/emulation-plans/
!/data/intel/
!/data/validation/

# Interrupted-download temp file from scripts/acquire_attack_bundle.py's
# atomic-write step — must never be committed even if a download fails.
*.part

# Local assistant/tooling settings (not part of the project)
.claude/
