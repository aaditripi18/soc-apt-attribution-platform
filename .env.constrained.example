# G0.7 platform-stack configuration — the CONSTRAINED profile for an 8 GB
# host, retained as a documented fallback (C0.2 §A.1.3, §I): small ES heap,
# single node, security still ON, ML/monitoring off (Basic tier has neither
# enabled by default), Kibana only brought up when actually needed.
#
# Usage:
#   cp .env.constrained.example .env
#   # then edit ELASTIC_PASSWORD / KIBANA_PASSWORD below
#   docker compose up -d setup es01        # Elasticsearch only
#   docker compose up -d kibana            # add Kibana only when needed
#
# .env is gitignored (see .gitignore) — never commit real passwords.

# --- Pinned image versions (docker.elastic.co) -----------------------------
# Must match .env.example's STACK_VERSION — Elasticsearch and Kibana MUST be
# the same version.
STACK_VERSION=8.15.3

# --- Cluster / ports ---------------------------------------------------------
CLUSTER_NAME=attribution-platform-dev
ES_PORT=9200
KIBANA_PORT=5601

# --- Credentials (REQUIRED — compose refuses to start without these) -------
ELASTIC_PASSWORD=changeme-elastic
KIBANA_PASSWORD=changeme-kibana

# --- Resource sizing (constrained / 8 GB host profile) ----------------------
# Small ES heap; cap container memory explicitly (C0.2 §I). Run Kibana only
# when needed, or rely on the replay path with Kibana stopped.
ES_HEAP=1g
ES_MEM_LIMIT=2g
KB_MEM_LIMIT=1g
